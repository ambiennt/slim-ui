{
	"namespace": "play",
	"play_screen@common.base_screen": {
		"cache_screen": true,

		"variables": [],

		"button_mappings": [
			{
				"from_button_id": "button.menu_cancel",
				"to_button_id": "button.menu_exit",
				"mapping_type": "global"
			},
			{
				"from_button_id": "button.menu_tab_left",
				"to_button_id": "button.menu_tab_left",
				"mapping_type": "global",
				"scope": "view"
			},
			{
				"from_button_id": "button.menu_tab_right",
				"to_button_id": "button.menu_tab_right",
				"mapping_type": "global",
				"scope": "view"
			}
		],
		"$screen_content": "play.sui_play_screen_content",
		"$world_picker_screen": false
	},
	"sui_play_screen_content": {
		"type": "panel",
		"controls": [
			{
				"sui_main_panel@play.sui_play_panel": {}
			}
		]
	},
	"sui_play_panel": {
		"type": "panel",
		"size": "$play_screen_size",
		"controls": [
			{
				"sui_left_tab_hint@common.keyboard_left_trigger": {
					"offset": [ -1, 0 ],
					"anchor_from": "top_left",
					"anchor_to": "top_right",
					"$hide_description": true,
					"$text_color": [ 1, 1, 1 ]
				}
			},
			{
				"sui_right_tab_hint@common.keyboard_right_trigger": {
					"offset": [ 1, 0 ],
					"anchor_from": "top_right",
					"anchor_to": "top_left",
					"$hide_description": true,
					"$text_color": [ 1, 1, 1 ]
				}
			},
			{
				"sui_tab_row@play.sui_tab_row": {}
			},
			{
				"sui_content@play.sui_content_area": {}
			}
		]
	},
	"sui_tab_row": {
		"type": "stack_panel",
		"orientation": "horizontal",
		"size": [
			"100%",
			30
		],
		"anchor_from": "top_middle",
		"anchor_to": "top_middle",
		"controls": [
			{
				"sui_navigation_tabs": {
					"type": "stack_panel",
					"orientation": "horizontal",
					"size": [ "fill", "100%" ],
					"controls": [
						{
							"sui_navigation_tabs_content": {
								"type": "stack_panel",
								"orientation": "horizontal",
								"size": [ "100% + 2px", "100%" ],
								"controls": [
									{ "sui_world_navigation_tab@play.sui_world_tab": { "size": [ "33%", "100%" ] } },
									{ "sui_friends_navigation_tab@play.sui_friends_tab": { "size": [ "33%", "100%" ] } },
									{ "sui_server_navigation_tab@play.sui_servers_tab": { "size": [ "fill", "100%" ] } }
								]
							}
						}
					]
				}
			},
			{
				"sui_close_tab": {
					"type": "panel",
					"size": [
						30,
						30
					],
					"controls": [
						{
							"sui_close_background": {
								"type": "image",
								"texture": "textures/ui/XTab"
							}
						},
						{
							"sui_close_button@common.light_close_button": {
								"anchor_from": "center",
								"anchor_to": "center",
								"offset": [ 0, -1 ],
								"focus_identifier": "close_button"
							}
						}
					]
				}
			}
		]
	},
	"sui_tab@common_tabs.tab_top": {
		"$radio_toggle_group": true,
		"$toggle_name": "navigation_tab",
		"$toggle_group_default_selected": "$default_tab",
		"$tab_content": "play.sui_tab_label",
		"anchor_from": "top_left",
		"anchor_to": "top_left"
	},
	"sui_tab_label": {
		"type": "stack_panel",
		"orientation": "horizontal",
		"size": [ "100% - 3px", "100% - 4px" ],
		"$show_tab_count|default": true,
		"controls": [
			{ "sui_left_gap": { "type": "panel", "size": [ 2, "100%" ] } },
			{ "sui_icon@$tab_icon": { "anchor_from": "left_middle", "anchor_to": "left_middle", "layer": 3 } },
			{ "sui_icon_gap": { "type": "panel", "size": [ 2, "100%" ] } },
			{
				"sui_text_and_count": {
					"type": "stack_panel",
					"orientation": "vertical",
					"size": [ "fill", "100%" ],
					"controls": [
						{
							"sui_tab_text": {
								"type": "label",
								"text": "$tab_text",
								"size": [ "100%", 12 ],
								"offset": [ -1, 0 ],
								"color": "$text_color",
								"layer": 3
							}
						},
						{
						"sui_count_section": {
							"type": "panel",
							"size": [ "100%c", "100%c" ],
							"ignored": "(not $show_tab_count)",
								"$count_background_image|default": "textures/ui/numberBGBack",
								"$count_text_color|default": "$text_color",
								"variables": [
									{
										"requires": "$is_checked_state",
										"$count_background_image": "textures/ui/numberBGFront",
										"$count_text_color": "$secondary_text_color"
									},
									{
										"requires": "($is_hover_state or not $is_checked_state)",
										"$count_background_image": "textures/ui/numberBGBack",
										"$count_text_color": "$text_color"
									}
								],
								"controls": [
									{
										"sui_tab_count_background": {
											"type": "image",
											"texture": "$count_background_image",
											"size": [ "100%c + 3px", "100%c" ],
											"offset": [ -1, -2 ],
											"anchor_from": "bottom_right",
											"anchor_to": "bottom_right",
											"layer": 3,
											"controls": [
												{
													"sui_tab_count": {
														"type": "label",
														"text": "$tab_count",
														"offset": [ 1, 1 ],
														"color": "$count_text_color",
														"layer": 4,
														"shadow": false,
														"bindings": [ { "binding_name": "$tab_count" } ]
													}
												}
											]
										}
									}
								]
							}
						}
					]
				}
			}
		]
	},
	"sui_worlds_icon": {
		"type": "image",
		"texture": "textures/ui/worldsIcon",
		"size": [ 16, 17 ]
	},
	"sui_friends_icon": {
		"type": "panel",
		"size": [ 16, 17 ],
		"controls": [
			{ "sui_friend_back": { "type": "image", "texture": "textures/ui/Friend2", "size": [ 10, 10 ], "anchor_from": "top_left", "anchor_to": "top_left" } },
			{ "sui_friend_front": { "type": "image", "texture": "textures/ui/Friend1", "size": [ 10, 10 ], "anchor_from": "top_left", "anchor_to": "top_left", "offset": [ 5, 5 ] } }
		]
	},
	"sui_servers_icon": {
		"type": "image",
		"texture": "textures/ui/servers",
		"size": [ 15, 15 ]
	},
	"sui_world_tab@play.sui_tab": {
		"$is_left_most_tab": true,
		"$tab_view_binding_name": "world_navigation_tab_toggle",
		"$toggle_group_forced_index": 0,
		"$tab_text": "selectWorld.tab.worlds",
		"$tab_icon": "play.sui_worlds_icon",
		"$tab_count": "#world_item_count"
	},
	"sui_friends_tab@play.sui_tab": {
		"$tab_view_binding_name": "friends_navigation_tab_toggle",
		"$toggle_group_forced_index": 1,
		"$tab_text": "selectWorld.tab.friends",
		"$tab_icon": "play.sui_friends_icon",
		"$tab_count": "#friend_world_item_count"
	},
	"sui_servers_tab@play.sui_tab": {
		"$tab_view_binding_name": "server_navigation_tab_toggle",
		"$toggle_group_forced_index": 2,
		"$tab_text": "selectWorld.tab.thirdParty",
		"$tab_icon": "play.sui_servers_icon",
		"$tab_count": "#server_world_item_count",
		"$show_tab_count": false
	},
	"sui_content_area": {
		"type": "panel",
		"size": [
			"100%",
			"100% - 26px"
		],
		"anchor_from": "bottom_middle",
		"anchor_to": "bottom_middle",
		"controls": [
			{
				"sui_background@common.common_panel": {
					"$dialog_background": "dialog_background_hollow_4",
					"$show_close_button": false
				}
			},
			{
				"sui_worlds_content@play.sui_tab_content": {
					"$tab_toggle": "world_navigation_tab_toggle",
					"$tab_content": "play.sui_worlds_content"
				}
			},
			{
				"sui_friends_content@play.sui_tab_content": {
					"$tab_toggle": "friends_navigation_tab_toggle",
					"$tab_content": "play.sui_friends_content"
				}
			},
			{
				"sui_servers_content@play.sui_tab_content": {
					"$tab_toggle": "server_navigation_tab_toggle",
					"$tab_content": "play.sui_servers_content"
				}
			}
		]
	},
	"sui_tab_content": {
		"type": "panel",
		"size": [
			"100% - 12px",
			"100% - 12px"
		],
		"offset": [
			6,
			6
		],
		"anchor_from": "top_left",
		"anchor_to": "top_left",
		"layer": 2,
		"controls": [
			{
				"sui_content@$tab_content": {
					"size": [
						"100%",
						"100%"
					]
				}
			}
		],
		"bindings": [
			{
				"binding_type": "view",
				"source_control_name": "$tab_toggle",
				"source_property_name": "#toggle_state",
				"target_property_name": "#visible"
			}
		]
	},
	"sui_worlds_content@play.sui_common_content": {
		"controls": [
			{
				"sui_scrolling_panel@play.sui_scrolling_offsets": {
					"$scrolling_content": "play.sui_worlds_list"
				}
			}
		]
	},
	"sui_worlds_list@play.sui_common_scroll_pane": {
		"controls": [
			{
				"sui_stack": {
					"type": "stack_panel",
					"orientation": "vertical",
					"size": [
						"100%",
						"100%c"
					],
					"controls": [
						{
							"sui_top_gap": {
								"type": "panel",
								"size": [ "100%", 2 ]
							}
						},
						{
							"sui_header": {
								"type": "stack_panel",
								"orientation": "horizontal",
								"size": [
									"100%",
									30
								],
								"controls": [
									{
										"sui_create_world@common_buttons.light_text_button": {
											"size": [
												"fill",
												30
											],
											"$pressed_button_name": "button.menu_local_world_create",
											"$button_text": "selectWorld.createNew"
										}
									},
									{
										"sui_import_world@play.sui_import_world_button": {
											"size": [
												30,
												30
											]
										}
									}
								]
							}
						},
						{
							"sui_header_gap": {
								"type": "panel",
								"size": [
									"100%",
									4
								]
							}
						},
						{
							"sui_worlds_label": {
								"type": "label",
								"size": [ "100%", 12 ],
								"text": "playscreen.worlds",
								"anchor_from": "top_left",
								"anchor_to": "top_left",
								"offset": [ 7, 0 ],
								"color": "$main_header_text_color",
								"bindings": [
									{ "binding_name": "#local_worlds_visible", "binding_name_override": "#visible" }
								]
							}
						},
						{
							"sui_worlds_grid@play.sui_local_world_item_grid": {}
						}
					]
				}
			}
		]
	},
	"sui_friends_content@play.sui_common_content": {
		"controls": [
			{
				"sui_scrolling_panel@play.sui_scrolling_offsets": {
					"$scrolling_content": "play.sui_friends_list"
				}
			}
		]
	},
	"sui_friends_list@play.sui_common_scroll_pane": {
		"controls": [
			{
				"sui_stack": {
					"type": "stack_panel",
					"orientation": "vertical",
					"size": [
						"100%",
						"100%c"
					],
					"controls": [
						{
							"sui_top_gap": {
								"type": "panel",
								"size": [ "100%", 2 ]
							}
						},
						{
							"sui_add_friend@play.sui_add_friend_button": {
								"size": [
									"100%",
									30
								],
								"bindings": [
									{
										"binding_name": "#add_friend_button_visible",
										"binding_name_override": "#visible",
										"binding_type": "global"
									}
								]
							}
						},
						{
							"sui_friends_gap": {
								"type": "panel",
								"size": [
									"100%",
									4
								],
								"bindings": [
									{ "binding_name": "#friends_grid_visible", "binding_name_override": "#visible" }
								]
							}
						},
						{
							"sui_friends_label": {
								"type": "label",
								"size": [
									"100%",
									12
								],
								"text": "networkWorld.joinable_friends_label",
								"color": "$main_header_text_color",
								"bindings": [
									{ "binding_name": "#friends_grid_visible", "binding_name_override": "#visible" }
								]
							}
						},
						{
							"sui_friends_grid@play.sui_network_world_item_grid": {
								"$network_world_grid_item_template": "play.sui_network_world_item_ignore_crossplay",
								"$network_world_item_grid_dimension_binding": "#friends_network_world_item_grid_dimension",
								"$collection_name": "friends_network_worlds",
								"$header_icon_visible": true,
								"$hide_network_icon": true,
								"bindings": [
									{
										"binding_name": "#friends_network_world_item_grid_dimension"
									},
									{
										"binding_name": "#friends_grid_visible",
										"binding_name_override": "#visible"
									}
								]
							}
						},
						{
							"sui_lan_gap": {
								"type": "panel",
								"size": [
									"100%",
									4
								],
								"bindings": [
									{ "binding_name": "#lan_grid_visible", "binding_name_override": "#visible" }
								]
							}
						},
						{
							"sui_lan_label": {
								"type": "label",
								"size": [
									"100%",
									12
								],
								"text": "networkWorld.lan_label",
								"color": "$main_header_text_color",
								"bindings": [
									{ "binding_name": "#lan_grid_visible", "binding_name_override": "#visible" }
								]
							}
						},
						{
							"sui_lan_grid@play.sui_network_world_item_grid": {
								"$network_world_grid_item_template": "play.sui_network_world_item_ignore_crossplay",
								"$network_world_item_grid_dimension_binding": "#lan_network_world_item_grid_dimension",
								"$collection_name": "lan_network_worlds",
								"$hide_network_icon": true,
								"bindings": [
									{
										"binding_name": "#lan_network_world_item_grid_dimension"
									},
									{
										"binding_name": "#lan_grid_visible",
										"binding_name_override": "#visible"
									}
								]
							}
						}
					]
				}
			}
		]
	},
	"sui_servers_content@play.sui_common_content": {
		"controls": [
			{
				"sui_scrolling_panel@play.sui_scrolling_offsets": {
					"$scrolling_content": "play.sui_servers_list"
				}
			}
		]
	},
	"sui_servers_list@play.sui_common_scroll_pane": {
		"controls": [
			{
				"sui_stack": {
					"type": "stack_panel",
					"orientation": "vertical",
					"size": [
						"100%",
						"100%c"
					],
					"controls": [
						{
							"sui_top_gap": {
								"type": "panel",
								"size": [ "100%", 2 ]
							}
						},
						{
							"sui_add_server_button@play.sui_add_server_toggle_button": {
								"size": [
									"100%",
									30
								]
							}
						},
						{
							"sui_server_gap": {
								"type": "panel",
								"size": [
									"100%",
									4
								]
							}
						},
						{
							"sui_server_label": {
								"type": "label",
								"size": [
									"100%",
									12
								],
								"text": "networkWorld.more_servers",
								"color": "$main_header_text_color"
							}
						},
						{
							"sui_more_servers_grid@play.sui_more_servers_grid": {}
						}
					]
				}
			}
		]
	},
	"sui_more_servers_grid": {
		"type": "grid",
		"size": [
			"100%",
			"default"
		],
		"layer": 1,
		"grid_item_template": "sui_more_servers_world_item",
		"grid_dimension_binding": "#servers_network_world_item_grid_dimension",
		"collection_name": "servers_network_worlds",
		"$collection_name": "servers_network_worlds",
		"anchor_to": "top_left",
		"anchor_from": "top_left",
		"bindings": [
			{
				"binding_name": "#servers_network_world_item_grid_dimension"
			}
		]
	},
	"sui_more_servers_world_item": {
		"type": "stack_panel",
		"anchor_from": "top_left",
		"anchor_to": "top_left",
		"layer": 1,
		"size": [
			"100%",
			30
		],
		"orientation": "horizontal",
		"controls": [
			{
				"sui_more_servers_join_button_panel": {
					"type": "panel",
					"size": [
						"fill",
						"100% + 1px"
					],
					"layer": 1,
					"controls": [
						{
							"sui_more_servers_join_button@common_buttons.dark_content_button": {
								"size": [
									"100%",
									"100%"
								],
								"$pressed_button_name": "button.menu_network_world_item",
								"$button_content": "play.sui_more_servers_button_content_panel",
								"bindings": [
									{
										"binding_type": "collection_details",
										"binding_collection_name": "$collection_name"
									}
								]
							}
						}
					]
				}
			},
			{
				"sui_network_server_world_edit_button@play.sui_network_server_world_edit_button": {
					"ignored": "$ignore_add_servers",
					"layer": 1
				}
			}
		]
	},
	"sui_more_servers_button_content_panel": {
		"type": "stack_panel",
		"orientation": "horizontal",
		"size": [
			"100%",
			"100%"
		],
		"variables": [
			{
				"requires": "$default_state",
				"$border_texture": "textures/ui/default_indent"
			},
			{
				"requires": "$hover_state",
				"$border_texture": "textures/ui/world_screenshot_focus_border"
			},
			{
				"requires": "$pressed_state",
				"$border_texture": "textures/ui/world_screenshot_focus_border"
			},
			{
				"requires": "$locked_state",
				"$border_texture": "textures/ui/default_indent"
			}
		],
		"controls": [
			{
				"sui_network_world_content_text_area_panel@play.sui_network_world_content_text_area_panel": {
					"size": [
						"fill",
						"100%"
					],
					"layer": 1
				}
			},
			{
				"sui_ping_rate_panel@play.sui_ping_rate_panel": {}
			},
			{
				"sui_ping_loading@progress.progress_loading_bars": {
					"size": [ 32, "100%" ],
					"layer": 5,
					"color": "$text_color",
					"bindings": [
						{
							"binding_type": "collection",
							"binding_name": "(not #is_network_available_and_ping_not_loading)",
							"binding_name_override": "#visible",
							"binding_collection_name": "third_party_server_network_worlds"
						}
					]
				}
			},
			{
				"sui_padding_for_ambient": {
					"type": "panel",
					"size": [
						2,
						"100%"
					]
				}
			}
		]
	},
	"sui_scrolling_offsets@play.sui_common_scrolling_panel": {
		"size": [
			"100% - 4px",
			"100% - 4px"
		],
		"offset": [
			2,
			2
		],
		"anchor_from": "top_left",
		"anchor_to": "top_left"
	},
	"sui_import_world_button@play.sui_common_button_template": {
		"variables": [
			{
				"requires": "($local_world_upload)",
				"$pressed_button_name": "button.archived_world_upload"
			},
			{
				"requires": "(not $local_world_upload)",
				"$pressed_button_name": "button.menu_import_level"
			}
		],
