{
	"namespace": "sui_common",
	"sui_lan_icon": {
		"type": "image",
		"texture": "textures/ui/lan_icon",
		"size": [ 14, 14 ]
	},

	"sui_change_skin_icon": {
		"type": "image",
		"texture": "textures/ui/hangar",
		"size": [ 32, 16 ],
		"anchor_from": "left_middle",
		"anchor_to": "left_middle",
		"color": [ 0.3, 0.3, 0.3 ],
		"layer": 3
	},

	"sui_change_skin_button@common_buttons.light_glyph_button": {
		"size": [ 29, 26 ],
		"$button_content": "sui_common.sui_change_skin_icon",
		"$button_content_offset": [ 3, 2 ],
		"anchor_from": "bottom_middle",
		"anchor_to": "bottom_middle",
		"$pressed_alpha": 0.65
	},

	"sui_profile_avatar": {
		"type": "panel",
		"size": [ "100%y", "100%" ],
		"controls": [
			{
				"sui_gamerpic": {
					"type": "custom",
					"renderer": "profile_image_renderer",
					"size": [ 16, 16 ],
					"layer": 2,
					"bindings": [
						{ "binding_name": "#profile_image_options" },
						{
							"binding_name": "$sui_gamerpic_visible",
							"binding_name_override": "#visible"
						}
					]
				}
			},
			{
				"sui_alex_icon": {
					"type": "image",
					"texture": "textures/ui/icon_alex",
					"size": [ 16, 16 ],
					"layer": 1,
					"bindings": [
						{
							"binding_name": "(not $sui_gamerpic_visible)",
							"binding_name_override": "#visible"
						}
					]
				}
			},
			{ "sui_border@common.focus_border_black": { "size": "$sui_avatar_size", "layer": 3 } }
		]
	},

	"sui_profile_content": {
		"type": "stack_panel",
		"orientation": "horizontal",
		"size": [ "100%c", 24 ],
		"controls": [
			{ "sui_avatar_space": { "type": "panel", "size": "$sui_avatar_size" } },
			{ "sui_gap@common.empty_panel": { "size": [ 2, "100%" ] } },
			{
				"sui_centered_text": {
					"type": "stack_panel",
					"orientation": "vertical",
					"size": [ "100%c", "100%c" ],
					"controls": [
						{ "sui_top_gap": { "type": "panel", "size": [ 0, 4 ] } },
						{
							"sui_profile_label@common_buttons.new_ui_binding_button_label": {
								"layer": 1,
								"$button_text": "menu.profile",
								"$button_text_size": [ "default", "default" ],
								"$button_text_max_size": [ "default", 20 ],
								"$button_text_binding_type": "none",
								"$button_binding_condition": "none",
								"$button_text_grid_collection_name": ""
							}
						}
					]
				}
			},
			{ "sui_right_gap@common.empty_panel": { "size": [ 6, "100%" ] } }
		]
	},

	"sui_profile_button@common_buttons.light_content_form_fitting_button": {
		"size": [ "100%cm", 24 ],
		"$sui_avatar_size": [ 18, 18 ],
		"$button_content_size_override": [ "100%c", "100%c - 4px" ],
		"$button_content": "sui_common.sui_profile_content",
		"$pressed_button_name": "button.menu_profile",
		"default_control": "sui_default",
		"hover_control": "sui_hover",
		"locked_control": "sui_locked",
		"pressed_control": "sui_pressed",
		"controls": [
			{
				"sui_default@$button_state_panel": {
					"$new_ui_button_texture": "$default_button_texture",
					"$text_color": "$default_text_color",
					"$border_color": "$light_border_default_color"
				}
			},
			{
				"sui_hover@$button_state_panel": {
					"$new_ui_button_texture": "$hover_button_texture",
					"$text_color": "$light_button_hover_text_color",
					"$border_color": "$light_border_hover_color",
					"layer": 2
				}
			},
			{
				"sui_locked@$button_state_panel": {
					"$new_ui_button_texture": "$locked_button_texture",
					"$text_color": "$light_button_locked_text_color",
					"$border_color": "$light_border_locked_color",
					"$button_image": "common_buttons.locked_button_image"
				}
			},
			{
				"sui_avatar_layout": {
					"type": "stack_panel",
					"orientation": "vertical",
					"size": [ "100%cm", 24 ],
					"anchor_from": "top_left",
					"anchor_to": "top_left",
					"controls": [
						{
							"sui_pressed": {
								"type": "panel",
								"size": [ "100%c", 1 ],
								"controls": [
									{
										"sui_pressed_face@$button_state_panel": {
											"$new_ui_button_texture": "$pressed_button_texture",
											"$text_color": "$light_button_pressed_text_color",
											"$border_color": "$light_border_pressed_color",
											"$button_offset": "$button_pressed_offset",
											"layer": 3
										}
									}
								]
							}
						},
						{
							"sui_avatar@sui_common.sui_profile_avatar": {
								"anchor_from": "top_left",
								"anchor_to": "top_left",
								"layer": 8
							}
						}
					]
				}
			}
		]
	},

	"sui_list_row_skin": {
		"type": "panel",
		"$sui_thumbnail_border|default": "textures/ui/default_indent",
		"$sui_thumbnail_offset|default": [ 0, 0 ],
		"controls": [
			{
				"sui_surface": {
					"type": "image",
					"texture": "$sui_surface_texture",
					"size": [ "100% - 2px", "100% - 2px" ],
					"layer": 1
				}
			},
			{
				"sui_outline": {
					"type": "image",
					"texture": "textures/ui/focus_border_white",
					"color": "$sui_outline_color",
					"layer": 2
				}
			},
			{
				"sui_thumbnail_inset": {
					"ignored": "(not $sui_has_world_thumbnail)",
					"type": "panel",
					"size": "$sui_content_size",
					"offset": "$sui_thumbnail_offset",
					"controls": [
						{
							"sui_thumbnail_bounds": {
								"type": "panel",
								"size": "$sui_picture_size",
								"anchor_from": "left_middle",
								"anchor_to": "left_middle",
								"offset": [ 1, 0 ],
								"controls": [
									{
										"sui_thumbnail_border": {
											"type": "image",
											"texture": "$sui_thumbnail_border",
											"size": [ "100% + 2px", "100% + 2px" ],
											"layer": 3
										}
									}
								]
							}
						}
					]
				}
			}
		]
	},
	"sui_list_row_button": {
		"type": "button",
		"$sui_row_button_size|default": [ "100%", 31 ],
		"size": "$sui_row_button_size",
		"layer": 1,
		"focus_enabled": true,
		"focus_magnet_enabled": true,
		"focus_wrap_enabled": true,
		"sound_name": "random.click",
		"sound_volume": 1,
		"sound_pitch": 1,
		"default_control": "sui_default",
		"hover_control": "sui_hover",
		"pressed_control": "sui_pressed",
		"locked_control": "sui_locked",
		"$sui_content_size|default": [ "100% - 6px", "100% - 6px" ],
		"$sui_has_world_thumbnail|default": false,
		"button_mappings": [
			{ "from_button_id": "button.menu_select", "to_button_id": "$sui_row_action", "mapping_type": "pressed" },
			{ "from_button_id": "button.menu_ok", "to_button_id": "$sui_row_action", "mapping_type": "focused" }
		],
		"controls": [
			{
				"sui_default@sui_common.sui_list_row_skin": {
					"$sui_surface_texture": "textures/ui/button_borderless_dark",
					"$sui_outline_color": "$dark_border_default_color",
					"layer": 1
				}
			},
			{
				"sui_hover@sui_common.sui_list_row_skin": {
					"$sui_surface_texture": "textures/ui/button_borderless_darkhover",
					"$sui_outline_color": "$dark_border_hover_color",
					"$sui_thumbnail_border": "textures/ui/world_screenshot_focus_border",
					"layer": 2
				}
			},
			{
				"sui_locked@sui_common.sui_list_row_skin": {
					"$sui_surface_texture": "textures/ui/disabledButtonNoBorder",
					"$sui_outline_color": "$dark_border_locked_color",
					"layer": 1
				}
			},
			{
				"sui_content_layout": {
					"type": "stack_panel",
					"orientation": "vertical",
					"size": [ "100%", "100%" ],
					"controls": [
						{
							"sui_pressed": {
								"type": "panel",
								"size": [ "100%", 1 ],
								"controls": [
									{
										"sui_pressed_skin@sui_common.sui_list_row_skin": {
											"anchor_from": "top_left",
											"anchor_to": "top_left",
											"size": "$sui_row_button_size",
											"$sui_surface_texture": "textures/ui/button_borderless_darkpressed",
											"$sui_outline_color": "$dark_border_pressed_color",
											"$sui_thumbnail_border": "textures/ui/world_screenshot_focus_border",
											"$sui_thumbnail_offset": [ 0, 1 ],
											"layer": 3
										}
									}
								]
							}
						},
						{
							"sui_content_slot": {
								"type": "panel",
								"size": [ "100%", "100%" ],
								"layer": 8,
								"controls": [
									{ "sui_content@$sui_row_content": { "size": "$sui_content_size" } }
								]
							}
						}
					]
				}
			}
		]
	}
}
