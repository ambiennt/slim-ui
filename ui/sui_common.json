{
	"namespace": "sui_common",

	"sui_title_image": {
		"type": "image",
		"layer": 1,
		"texture": "textures/ui/title"
	},
	"sui_lan_icon": {
		"type": "image",
		"texture": "textures/ui/lan_icon",
		"size": [ 14, 14 ]
	},

	"sui_change_skin_icon": {
		"type": "image",
		"texture": "textures/ui/hangar",
		"size": [ 32, 16 ],
		"anchor_from": "left_middle",
		"anchor_to": "left_middle",
		"color": [ 0.3, 0.3, 0.3 ],
		"layer": 3
	},
	"sui_change_skin_button@common_buttons.light_glyph_button": {
		"size": [ 29, 26 ],
		"$button_content": "sui_common.sui_change_skin_icon",
		"$button_content_offset": [ 3, 2 ],
		"anchor_from": "bottom_middle",
		"anchor_to": "bottom_middle",
		"$pressed_alpha": 0.65
	},

	"sui_profile_avatar": {
		"type": "panel",
		"size": [ "100%y", "100%" ],
		"controls": [
			{
				"sui_gamerpic": {
					"type": "custom",
					"renderer": "profile_image_renderer",
					"size": [ 16, 16 ],
					"layer": 2,
					"bindings": [
						{ "binding_name": "#profile_image_options" },
						{ "binding_name": "$sui_gamerpic_visible", "binding_name_override": "#visible" }
					]
				}
			},
			{
				"sui_alex_icon": {
					"type": "image",
					"texture": "textures/ui/icon_alex",
					"size": [ 16, 16 ],
					"layer": 1,
					"bindings": [
						{ "binding_name": "(not $sui_gamerpic_visible)", "binding_name_override": "#visible" }
					]
				}
			},
			{ "sui_border@common.focus_border_black": { "size": "$sui_avatar_size", "layer": 3 } }
		]
	},
	"sui_profile_content": {
		"type": "stack_panel",
		"orientation": "horizontal",
		"size": [ "100%c", 24 ],
		"controls": [
			{ "sui_avatar_space": { "type": "panel", "size": "$sui_avatar_size" } },
			{ "sui_gap@common.empty_panel": { "size": [ 2, "100%" ] } },
			{
				"sui_centered_text": {
					"type": "stack_panel",
					"orientation": "vertical",
					"size": [ "100%c", "100%c" ],
					"controls": [
						{ "sui_top_gap": { "type": "panel", "size": [ 0, 4 ] } },
						{
							"sui_profile_label@common_buttons.new_ui_binding_button_label": {
								"layer": 1,
								"$button_text": "menu.profile",
								"$button_text_size": [ "default", "default" ],
								"$button_text_max_size": [ "default", 20 ],
								"$button_text_binding_type": "none",
								"$button_binding_condition": "none",
								"$button_text_grid_collection_name": ""
							}
						}
					]
				}
			},
			{ "sui_right_gap@common.empty_panel": { "size": [ 6, "100%" ] } }
		]
	},
	"sui_profile_button@common_buttons.light_content_form_fitting_button": {
		"size": [ "100%cm", 24 ],
		"$sui_avatar_size": [ 18, 18 ],
		"$button_content_size_override": [ "100%c", "100%c - 4px" ],
		"$button_content": "sui_common.sui_profile_content",
		"$pressed_button_name": "button.menu_profile",
		"default_control": "sui_default",
		"hover_control": "sui_hover",
		"locked_control": "sui_locked",
		"pressed_control": "sui_pressed",
		"controls": [
			{
				"sui_default@$button_state_panel": {
					"$new_ui_button_texture": "$default_button_texture",
					"$text_color": "$default_text_color",
					"$border_color": "$light_border_default_color"
				}
			},
			{
				"sui_hover@$button_state_panel": {
					"$new_ui_button_texture": "$hover_button_texture",
					"$text_color": "$light_button_hover_text_color",
					"$border_color": "$light_border_hover_color",
					"layer": 2
				}
			},
			{
				"sui_locked@$button_state_panel": {
					"$new_ui_button_texture": "$locked_button_texture",
					"$text_color": "$light_button_locked_text_color",
					"$border_color": "$light_border_locked_color",
					"$button_image": "common_buttons.locked_button_image"
				}
			},
			{
				"sui_avatar_layout": {
					"type": "stack_panel",
					"orientation": "vertical",
					"size": [ "100%cm", 24 ],
					"anchor_from": "top_left",
					"anchor_to": "top_left",
					"controls": [
						{
							"sui_pressed": {
								"type": "panel",
								"size": [ "100%c", 1 ],
								"controls": [
									{
										"sui_pressed_face@$button_state_panel": {
											"$new_ui_button_texture": "$pressed_button_texture",
											"$text_color": "$light_button_pressed_text_color",
											"$border_color": "$light_border_pressed_color",
											"$button_offset": "$button_pressed_offset",
											"layer": 3
										}
									}
								]
							}
						},
						{
							"sui_avatar@sui_common.sui_profile_avatar": {
								"anchor_from": "top_left",
								"anchor_to": "top_left",
								"layer": 8
							}
						}
					]
				}
			}
		]
	},

	"sui_list_row_skin": {
		"type": "panel",
		"$sui_thumbnail_border|default": "textures/ui/default_indent",
		"$sui_thumbnail_offset|default": [ 0, 0 ],
		"controls": [
			{ "sui_surface": { "type": "image", "texture": "$sui_surface_texture", "size": [ "100% - 2px", "100% - 2px" ], "layer": 1 } },
			{ "sui_outline": { "type": "image", "texture": "textures/ui/focus_border_white", "color": "$sui_outline_color", "layer": 2 } },
			{
				"sui_thumbnail_inset": {
					"ignored": "(not $sui_has_world_thumbnail)",
					"type": "panel",
					"size": "$sui_content_size",
					"offset": "$sui_thumbnail_offset",
					"controls": [
						{
							"sui_thumbnail_bounds": {
								"type": "panel",
								"size": "$sui_picture_size",
								"anchor_from": "left_middle",
								"anchor_to": "left_middle",
								"offset": [ 1, 0 ],
								"controls": [
									{ "sui_thumbnail_border": { "type": "image", "texture": "$sui_thumbnail_border", "size": [ "100% + 2px", "100% + 2px" ], "layer": 3 } }
								]
							}
						}
					]
				}
			}
		]
	},
	"sui_list_row_button": {
		"type": "button",
		"$sui_row_button_size|default": [ "100%", 31 ],
		"size": "$sui_row_button_size",
		"layer": 1,
		"focus_enabled": true,
		"focus_magnet_enabled": true,
		"focus_wrap_enabled": true,
		"sound_name": "random.click",
		"sound_volume": 1,
		"sound_pitch": 1,
		"default_control": "sui_default",
		"hover_control": "sui_hover",
		"pressed_control": "sui_pressed",
		"locked_control": "sui_locked",
		"$sui_content_size|default": [ "100% - 6px", "100% - 6px" ],
		"$sui_has_world_thumbnail|default": false,
		"button_mappings": [
			{ "from_button_id": "button.menu_select", "to_button_id": "$sui_row_action", "mapping_type": "pressed" },
			{ "from_button_id": "button.menu_ok", "to_button_id": "$sui_row_action", "mapping_type": "focused" }
		],
		"controls": [
			{
				"sui_default@sui_common.sui_list_row_skin": {
					"$sui_surface_texture": "textures/ui/button_borderless_dark",
					"$sui_outline_color": "$dark_border_default_color",
					"layer": 1
				}
			},
			{
				"sui_hover@sui_common.sui_list_row_skin": {
					"$sui_surface_texture": "textures/ui/button_borderless_darkhover",
					"$sui_outline_color": "$dark_border_hover_color",
					"$sui_thumbnail_border": "textures/ui/world_screenshot_focus_border",
					"layer": 2
				}
			},
			{
				"sui_locked@sui_common.sui_list_row_skin": {
					"$sui_surface_texture": "textures/ui/disabledButtonNoBorder",
					"$sui_outline_color": "$dark_border_locked_color",
					"layer": 1
				}
			},
			{
				"sui_content_layout": {
					"type": "stack_panel",
					"orientation": "vertical",
					"size": [ "100%", "100%" ],
					"controls": [
						{
							"sui_pressed": {
								"type": "panel",
								"size": [ "100%", 1 ],
								"controls": [
									{
										"sui_pressed_skin@sui_common.sui_list_row_skin": {
											"anchor_from": "top_left",
											"anchor_to": "top_left",
											"size": "$sui_row_button_size",
											"$sui_surface_texture": "textures/ui/button_borderless_darkpressed",
											"$sui_outline_color": "$dark_border_pressed_color",
											"$sui_thumbnail_border": "textures/ui/world_screenshot_focus_border",
											"$sui_thumbnail_offset": [ 0, 1 ],
											"layer": 3
										}
									}
								]
							}
						},
						{
							"sui_content_slot": {
								"type": "panel",
								"size": [ "100%", "100%" ],
								"layer": 8,
								"controls": [
									{ "sui_content@$sui_row_content": { "size": "$sui_content_size" } }
								]
							}
						}
					]
				}
			}
		]
	},

	"sui_container_screen_panel": {
		"type": "panel",
		"controls": [
			{
				"sui_backdrop@$screen_bg_content": {
					"anims": "$background_animations",
					"animation_reset_name": "screen_animation_reset",
					"propagate_alpha": true,
					"disable_anim_fast_forward": true,
					"layer": 2
				}
			},
			{
				"sui_safezone@sui_common.sui_container_safezone": {
					"anims": "$screen_animations",
					"animation_reset_name": "screen_animation_reset",
					"propagate_alpha": true,
					"disable_anim_fast_forward": true,
					"layer": "$safezone_screen_matrix_layer"
				}
			},
			{
				"sui_full_screen_background@common_dialogs.full_screen_background": {
					"anims": "$screen_animations",
					"animation_reset_name": "screen_animation_reset",
					"propagate_alpha": true,
					"disable_anim_fast_forward": true,
					"layer": -1
				}
			},
			{
				"sui_loading_bars_background": {
					"type": "image",
					"visible": "$use_loading_bars",
					"texture": "textures/ui/effect_background",
					"size": [ "33%", "100%c + 16px" ],
					"alpha": 0,
					"propagate_alpha": true,
					"animation_reset_name": "screen_animation_reset",
					"disable_anim_fast_forward": true,
					"anims": [ "@common.loading_bar_init_animation_push", "@common.loading_bar_init_animation_pop" ],
					"controls": [
						{ "sui_loading_bars@common_store.progress_loading_bars": { "size": [ "100%", "8%x" ], "max_size": [] } }
					]
				}
			}
		]
	},
	"sui_container_safezone_buffer": {
		"type": "panel",
		"bindings": [
			{ "binding_name": "$sui_safezone_visible", "binding_name_override": "#visible" }
		]
	},
	"sui_container_safezone": {
		"type": "stack_panel",
		"orientation": "horizontal",
		"size": [ "100%", "100%" ],
		"controls": [
			{ "sui_outer_left@sui_common.sui_container_safezone_buffer": { "size": "$left_horizontal_safezone_size", "$sui_safezone_visible": "#safezone_outer_left" } },
			{ "sui_inner_left@sui_common.sui_container_safezone_buffer": { "size": "$left_horizontal_safezone_size", "$sui_safezone_visible": "#safezone_inner_left", "anchor_from": "top_left", "anchor_to": "top_left" } },
			{
				"sui_safezone_rows": {
					"type": "stack_panel",
					"orientation": "vertical",
					"size": [ "fill", "100%" ],
					"controls": [
						{ "sui_outer_top@sui_common.sui_container_safezone_buffer": { "size": "$top_vertical_safezone_size", "$sui_safezone_visible": "#safezone_outer_top" } },
						{ "sui_inner_top@sui_common.sui_container_safezone_buffer": { "size": "$top_vertical_safezone_size", "$sui_safezone_visible": "#safezone_inner_top" } },
						{ "sui_content_area@sui_common.sui_container_content_area": {} },
						{ "sui_inner_bottom@sui_common.sui_container_safezone_buffer": { "size": "$bottom_vertical_safezone_size", "$sui_safezone_visible": "#safezone_inner_bottom" } },
						{ "sui_outer_bottom@sui_common.sui_container_safezone_buffer": { "size": "$bottom_vertical_safezone_size", "$sui_safezone_visible": "#safezone_outer_bottom" } }
					]
				}
			},
			{ "sui_inner_right@sui_common.sui_container_safezone_buffer": { "size": "$right_horizontal_safezone_size", "$sui_safezone_visible": "#safezone_inner_right" } },
			{ "sui_outer_right@sui_common.sui_container_safezone_buffer": { "size": "$right_horizontal_safezone_size", "$sui_safezone_visible": "#safezone_outer_right" } }
		]
	},
	"sui_container_content_area": {
		"type": "panel",
		"size": [ "100%", "fill" ],
		"$modal_screen_size|default": [ 204, 140 ],
		"controls": [
			{ "root_screen_panel@$screen_content": {} },
			{ "additional_screen_content@$additional_screen_content": {} },
			{
				"popup_dialog_factory": {
					"type": "factory",
					"control_ids": {
						"modal_dialog_popup": "@popup_dialog.modal_dialog_popup",
						"storage_dependency_popup": "@storage_management_popup.storage_dependency_modal",
						"storage_sharing_popup": "@storage_management_popup.sharing_popup_content"
					}
				}
			},
			{ "sui_bundle_tooltip@sui_common.sui_bundle_tooltip": {} }
		]
	},

	"sui_selected_item_details_factory": {
		"type": "panel",
		"factory": {
			"name": "selected_item_details_factory",
			"control_name": "popup_tip_text@sui_common.sui_selected_item_details"
		}
	},
	"sui_selected_item_details": {
		"type": "panel",
		"anchor_from": "bottom_middle",
		"anchor_to": "bottom_middle",
		"size": [ "100%c", "100%c" ],
		"$sui_item_details_offset|default": [ 0, "-16px" ],
		"offset": "$sui_item_details_offset",
		"layer": 30,
		"controls": [
			{ "sui_item_image@sui_common.sui_item_panel_image": {} }
		],
		"bindings": [
			{ "binding_name": "#recipe_details_label", "binding_name_override": "#visible" }
		]
	},
	"sui_item_panel_image": {
		"type": "image",
		"texture": "textures/ui/purpleBorder",
		"size": [ "100%c + 8px", "100%c + 8px" ],
		"layer": 30,
		"visible": "#visible",
		"alpha": "@sui_common.sui_item_details_fade",
		"controls": [
			{ "sui_text@sui_common.sui_item_text_label": {} }
		]
	},
	"sui_item_text_label": {
		"type": "label",
		"text": "#selected_hover_text",
		"color": [ 1, 1, 1 ],
		"localize": false,
		"enable_profanity_filter": false,
		"alpha": "@sui_common.sui_item_details_fade",
		"layer": 1
	},
	"sui_item_details_fade": {
		"anim_type": "alpha",
		"easing": "in_quint",
		"duration": 2,
		"from": 1,
		"to": 0,
		"destroy_at_end": "popup_tip_text"
	},

	"sui_item_lock_notification_factory": {
		"type": "panel",
		"factory": {
			"name": "item_lock_notification_factory",
			"control_name": "popup_notification_text@sui_common.sui_item_lock_notification"
		}
	},
	"sui_item_lock_notification": {
		"type": "panel",
		"anchor_from": "top_middle",
		"anchor_to": "top_middle",
		"size": [ "100%c", "100%c" ],
		"$sui_item_lock_notification_offset|default": [ 0, "6%" ],
		"offset": "$sui_item_lock_notification_offset",
		"layer": 30,
		"controls": [
			{
				"sui_notification_background": {
					"type": "image",
					"texture": "textures/ui/hud_tip_text_background",
					"size": [ "100%c + 12px", "100%c + 5px" ],
					"layer": 30,
					"alpha": "@sui_common.sui_item_lock_background_fade",
					"controls": [
						{
							"sui_notification_text": {
								"type": "label",
								"text": "#notification_text",
								"color": [ 1, 1, 1 ],
								"localize": true,
								"alpha": "@sui_common.sui_item_lock_text_fade",
								"layer": 1
							}
						}
					]
				}
			}
		]
	},
	"sui_item_lock_text_fade@sui_common.sui_item_details_fade": {
		"destroy_at_end": "popup_notification_text"
	},
	"sui_item_lock_background_fade@sui_common.sui_item_lock_text_fade": {
		"from": 0.6
	},

	"sui_bundle_tooltip": {
		"type": "custom",
		"renderer": "bundle_tooltip_renderer",
		"size": [ "100%cm", "100%cm" ],
		"layer": 20,
		"bindings": [
			{ "binding_name": "#show_bundle_tooltip_hover", "binding_name_override": "#visible", "binding_condition": "always" }
		],
		"controls": [
			{ "sui_contents@sui_common.sui_bundle_tooltip_content": {} }
		]
	},
	"sui_bundle_tooltip_content": {
		"type": "panel",
		"size": [ "100%cm", "100%cm" ],
		"min_size": [ 86, 58 ],
		"layer": 50,
		"controls": [
			{
				"sui_background": {
					"type": "image",
					"texture": "textures/ui/purpleBorder",
					"size": [ "100%sm + 10px", "100%sm + 10px" ],
					"anchor_from": "top_left",
					"anchor_to": "top_left",
					"layer": 1,
					"controls": [
						{
							"sui_selected_item@sui_common.sui_item_panel_image": {
								"anchor_from": "top_middle",
								"anchor_to": "bottom_middle",
								"alpha": 1,
								"bindings": [
									{ "binding_name": "#bundle_has_selected_item", "binding_name_override": "#visible" }
								],
								"controls": [
									{
										"sui_text@sui_common.sui_item_text_label": {
											"alpha": 1,
											"text": "#selected_bundle_item_text",
											"enable_profanity_filter": false,
											"bindings": [
												{ "binding_name": "#selected_bundle_item_text", "binding_condition": "visible" }
											]
										}
									}
								]
							}
						}
					]
				}
			},
			{
				"sui_bundle_name": {
					"type": "label",
					"min_size": [ 77, "default" ],
					"offset": [ 5, 5 ],
					"anchor_from": "top_left",
					"anchor_to": "top_left",
					"layer": 6,
					"color": "$main_header_text_color",
					"text": "#bundle_name",
					"enable_profanity_filter": false,
					"bindings": [
						{ "binding_name": "#bundle_name", "binding_condition": "visible" }
					]
				}
			},
			{
				"sui_body": {
					"type": "stack_panel",
					"orientation": "vertical",
					"size": [ "100%sm", "100%c" ],
					"anchor_from": "top_left",
					"anchor_to": "top_left",
					"layer": 2,
					"controls": [
						{ "sui_header_space": { "type": "panel", "size": [ 0, 18 ] } },
						{
							"sui_body_row": {
								"type": "stack_panel",
								"orientation": "horizontal",
								"size": [ "100%", "100%c" ],
								"controls": [
									{ "sui_left_inset": { "type": "panel", "size": [ "50% - 34px", 1 ] } },
									{ "sui_items@sui_common.sui_bundle_items": {} }
								]
							}
						}
					]
				}
			}
		]
	},
	"sui_bundle_items": {
		"type": "stack_panel",
		"orientation": "vertical",
		"size": [ "100%c", "100%c" ],
		"anchor_from": "bottom_left",
		"anchor_to": "bottom_left",
		"controls": [
			{
				"sui_item_grid": {
					"type": "grid",
					"collection_name": "bundle_items",
					"$item_collection_name": "bundle_items",
					"grid_dimension_binding": "#bundle_tooltip_grid_dimensions",
					"grid_item_template": "sui_common.sui_bundle_slot",
					"bindings": [
						{ "binding_name": "#bundle_tooltip_grid_dimensions", "binding_condition": "always_when_visible" }
					]
				}
			},
			{
				"sui_empty_description": {
					"type": "label",
					"size": [ 77, "default" ],
					"color": "$bundle_info_description_color",
					"text": "item.bundle.empty.description",
					"bindings": [
						{ "binding_name": "#is_selected_bundle_empty", "binding_name_override": "#visible" }
					]
				}
			},
			{
				"sui_footer": {
					"type": "panel",
					"size": [ 76, 15 ],
					"anchor_from": "bottom_middle",
					"anchor_to": "bottom_middle",
					"controls": [
						{ "sui_weight_bar@sui_common.sui_bundle_weight_bar": {} }
					]
				}
			}
		]
	},
	"sui_bundle_weight_bar": {
		"type": "panel",
		"size": [ 76, 12 ],
		"offset": [ 0, 3 ],
		"anchor_from": "bottom_middle",
		"anchor_to": "bottom_middle",
		"controls": [
			{
				"sui_empty_label": {
					"type": "label",
					"color": "$sub_header_text_color",
					"text": "item.bundle.empty",
					"shadow": true,
					"bindings": [
						{ "binding_name": "#is_selected_bundle_empty", "binding_name_override": "#visible" }
					]
				}
			},
			{
				"sui_fill": {
					"type": "image",
					"texture": "textures/ui/container_weight_bar_fill",
					"clip_direction": "left",
					"clip_pixelperfect": false,
					"bindings": [
						{ "binding_name": "#bundle_weight_bar_ratio", "binding_name_override": "#clip_ratio", "binding_condition": "always_when_visible" },
						{ "binding_name": "(not #is_selected_bundle_full)", "binding_name_override": "#visible" }
					]
				}
			},
			{
				"sui_full": {
					"type": "image",
					"texture": "textures/ui/container_weight_bar_full",
					"bindings": [
						{ "binding_name": "#is_selected_bundle_full", "binding_name_override": "#visible" }
					],
					"controls": [
						{ "sui_full_label": { "type": "label", "color": "$sub_header_text_color", "text": "item.bundle.full", "shadow": true, "layer": 2 } }
					]
				}
			},
			{ "sui_border": { "type": "image", "texture": "textures/ui/empty_stack_progress_bar" } }
		]
	},

	"sui_bundle_slot": {
		"type": "panel",
		"size": [ 20, 20 ],
		"controls": [
			{
				"sui_item@common.container_item": {
					"size": [ 18, 18 ],
					"$background_images": "sui_common.sui_bundle_slot_background",
					"$button_ref": "sui_common.sui_bundle_slot_button",
					"bindings": [
						{ "binding_type": "collection", "binding_collection_name": "$item_collection_name", "binding_name": "#show_bundle_item_slot", "binding_name_override": "#visible" }
					]
				}
			},
			{
				"sui_hidden_count": {
					"type": "label",
					"size": [ "default", 10 ],
					"color": "$item_stack_count_color",
					"text": "#more_hidden_items_text",
					"layer": 2,
					"bindings": [
						{ "binding_type": "collection", "binding_collection_name": "$item_collection_name", "binding_name": "#is_hidden_items_label", "binding_name_override": "#visible" },
						{ "binding_name": "#more_hidden_items_text", "binding_condition": "visible" }
					]
				}
			}
		]
	},
	"sui_bundle_slot_background": {
		"type": "panel",
		"controls": [
			{ "sui_background": { "type": "image", "texture": "textures/ui/bundle_item_background", "layer": 1 } },
			{
				"sui_selection": {
					"type": "panel",
					"bindings": [
						{ "binding_type": "collection", "binding_collection_name": "$item_collection_name", "binding_name": "#is_selected_bundle_item_slot", "binding_name_override": "#visible" }
					],
					"controls": [
						{ "sui_highlight@common.highlight_slot": { "size": [ "100%", "100%" ], "alpha": 1, "layer": 1 } },
						{ "sui_border@common.white_border_slot": { "layer": 2 } }
					]
				}
			}
		]
	},
	"sui_bundle_slot_button@common.container_slot_button_prototype": {
		"size": [ "100%", "100%" ],
		"sound_name": "random.click",
		"sound_volume": 1,
		"sound_pitch": 1,
		"button_mappings": [
			{ "from_button_id": "button.menu_cancel", "to_button_id": "button.hide_bundle_tooltip", "mapping_type": "pressed" },
			{ "from_button_id": "button.menu_select", "to_button_id": "button.tapped_bundle_item_icon", "mapping_type": "pressed" },
			{ "from_button_id": "button.menu_ok", "to_button_id": "button.tapped_bundle_item_icon", "mapping_type": "pressed" },
			{ "from_button_id": "button.menu_secondary_select", "to_button_id": "button.tapped_bundle_item_icon", "mapping_type": "pressed" },
			{ "from_button_id": "button.menu_auto_place", "to_button_id": "button.tapped_bundle_item_icon", "mapping_type": "pressed" },
			{ "from_button_id": "button.menu_inventory_drop", "to_button_id": "button.tapped_bundle_item_icon", "mapping_type": "pressed" },
			{ "from_button_id": "button.menu_inventory_drop_all", "to_button_id": "button.tapped_bundle_item_icon", "mapping_type": "pressed" }
		]
	}
}
